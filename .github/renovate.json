{
  "schedule": [
    "after 10pm every weekday",
    "every weekend",
    "before 5am every weekday"
  ],
  "extends": [
    "config:recommended",
    ":prHourlyLimitNone"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "enabled": false
    }
  ],
  "rebaseWhen": "behind-base-branch",
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  },
  "minimumReleaseAge": "7 days",
  "prCreation": "not-pending",
  "dependencyDashboard": true
}
